# Settings for running on a VPS (docker compose, or `npm run start:node`).
# Copy to .env and fill in. Never commit .env.
# (On Cloudflare these come from `wrangler secret put` instead — see README.)

# Your domain, pointed at this server (A record). Caddy gets the HTTPS certificate for it.
DOMAIN=wheel.example.mn

# Admin password for /#/admin — at least 10 characters.
ADMIN_PASSWORD=

# Long random string that signs admin logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Minutes ahead of UTC for the daily spin reset (Mongolia = 480).
UTC_OFFSET_MINUTES=480
