# Copy this file to .env and fill it in. Never commit .env.

# Password for /#/admin (at least 10 characters).
ADMIN_PASSWORD=1234567890

# Long random string used to sign admin logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# production when deployed (secure cookies, requires SESSION_SECRET).
NODE_ENV=development
PORT=3001
DATABASE_PATH=data/luckywheel.db

# Time zone for daily spin resets and dates.
TZ=Asia/Ulaanbaatar

# Set to 1 when the app runs behind nginx / a load balancer, so real visitor IPs are used.
TRUST_PROXY=0
